<div class="flex-1 min-w-0">
  <header
    class="h-16 bg-white border-b border-slate-200 flex items-center justify-between px-4 sm:px-8 sticky top-0 z-20"
  >
    <div class="flex items-center gap-3">
      <button
        @click="sidebarOpen=!sidebarOpen"
        class="lg:hidden p-2 text-slate-500"
      >
        <i data-lucide="menu" class="w-5 h-5"></i>
      </button>
      <a
        href="/admin/users"
        class="p-2 -ml-2 text-slate-500 hover:text-slate-700"
        ><i data-lucide="arrow-left" class="w-5 h-5"></i
      ></a>
      <h1 class="text-lg font-bold text-slate-900">Edit User</h1>
    </div>
    <button
      class="px-4 py-2 bg-indigo-600 text-white text-sm font-semibold rounded-lg hover:bg-indigo-700 transition"
    >
      Save User
    </button>
  </header>

  <main class="p-4 sm:p-8 max-w-2xl">
    <div class="bg-white rounded-2xl border border-slate-200 p-6 space-y-5">
      <div class="flex items-center gap-4 pb-5 border-b border-slate-100">
        <img
          src="<%= user.avatar %>"
          class="w-16 h-16 rounded-full"
          alt="User avatar"
        />
        <!-- <div class="flex gap-2">
              <button class="px-3 py-1.5 text-sm font-medium border border-slate-200 rounded-lg hover:bg-slate-50">Change photo</button>
              <button class="px-3 py-1.5 text-sm font-medium text-red-600 hover:bg-red-50 rounded-lg">Remove</button>
            </div> -->
      </div>

      <!-- <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1.5">First name</label>
              <input type="text" value="Leila" class="w-full px-3.5 py-2.5 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1.5">Last name</label>
              <input type="text" value="Tabrizi" class="w-full px-3.5 py-2.5 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
            </div>
          </div> -->
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5"
          >Username</label
        >
        <input
          disabled
          type="text"
          value="<%= user.username %>"
          class="w-full px-3.5 py-2.5 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none"
        />
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5"
          >Email address</label
        >
        <input
          disabled
          type="email"
          value="<%= user.email %>"
          class="w-full px-3.5 py-2.5 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none"
        />
      </div>
      <div class="grid sm:grid-cols-1 #gap-4">
        <div>
          <form action="/auth/change-role/<%= user.id %>" method="POST">
          <label class="block text-sm font-medium text-slate-700 mb-1.5"
            >Role</label
          >
          <select
            name="role"
            class="w-full px-3.5 py-2.5 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none"
          >
          <% roles.forEach(role => { %>
            <option 
            value="<%= role.toLowerCase() %>" 
            <%= user.role === role.toLowerCase() ? "selected" : "" %>
            >
              <%= role %>
            </option>
          <% }) %>
            <!-- <option value="author">Author</option>
            <option value="admin" selected>Admin</option> -->
          </select>
          <div class="flex justify-end gap-3 pt-2 border-t border-slate-100">
        <a
          href="/admin/users"
          class="px-4 py-2.5 text-sm font-semibold text-slate-600 hover:bg-slate-50 rounded-lg"
          >Cancel</a
        >
        <button
          class="px-5 py-2.5 text-sm font-semibold text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 transition"
        >
          Save User
        </button>
      </div>
          </form>
        </div>
        <!-- <div>
          <label class="block text-sm font-medium text-slate-700 mb-1.5"
            >Status</label
          >
          <select
            class="w-full px-3.5 py-2.5 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none"
          >
            <option selected>Active</option>
            <option>Suspended</option>
          </select>
        </div> -->
      </div>
      <!-- <div>
            <label class="block text-sm font-medium text-slate-700 mb-1.5">Reset password</label>
            <input type="password" placeholder="Leave blank to keep current password" class="w-full px-3.5 py-2.5 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
          </div> -->

      <!-- <div class="flex justify-end gap-3 pt-2 border-t border-slate-100">
        <a
          href="/admin/users"
          class="px-4 py-2.5 text-sm font-semibold text-slate-600 hover:bg-slate-50 rounded-lg"
          >Cancel</a
        >
        <button
          class="px-5 py-2.5 text-sm font-semibold text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 transition"
        >
          Save User
        </button>
      </div> -->
    </div>

    <div class="bg-white rounded-2xl border border-red-200 p-6 mt-6">
      <h3 class="font-bold text-red-600 mb-2">Danger Zone</h3>
      <p class="text-sm text-slate-500 mb-4">
        Deleting this user will remove their account and all associated data.
      </p>
      <button
        class="px-4 py-2 text-sm font-semibold text-red-600 border border-red-200 rounded-lg hover:bg-red-50"
      >
        Delete this user
      </button>
    </div>
  </main>
</div>
