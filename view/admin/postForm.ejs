<div class="flex-1 min-w-0">
      <header class="h-16 bg-white border-b border-slate-200 flex items-center justify-between px-4 sm:px-8 sticky top-0 z-20">
        <div class="flex items-center gap-3">
          <button @click="sidebarOpen=!sidebarOpen" class="lg:hidden p-2 text-slate-500"><i data-lucide="menu" class="w-5 h-5"></i></button>
          <a href="/admin/posts" class="p-2 -ml-2 text-slate-500 hover:text-slate-700"><i data-lucide="arrow-left" class="w-5 h-5"></i></a>
          <h1 class="text-lg font-bold text-slate-900">Create Post</h1>
        </div>
        <div class="flex items-center gap-3">
          <button class="px-4 py-2 text-sm font-semibold text-slate-600 border border-slate-200 rounded-lg hover:bg-slate-50">Save Draft</button>
          <button class="px-4 py-2 bg-indigo-600 text-white text-sm font-semibold rounded-lg hover:bg-indigo-700 transition">Publish</button>
        </div>
      </header>

      <main class="p-4 sm:p-8">
        <form action="/posts" method="POST"
        class="grid lg:grid-cols-[1fr_320px] gap-6">
          <!-- Main form -->
          <div class="space-y-6">
            <div class="bg-white rounded-2xl border border-slate-200 p-6">
              <label class="block text-sm font-medium text-slate-700 mb-1.5">Title</label>
                <% if(errors && errors.title){ %>
                <p class="text-red-500 text-xs mb-2"><%= errors.title %></p>
                <% } %>
              <input type="text" name="title"
              value="<%= oldData&& oldData.title ? oldData.title : "" %>"
              class="w-full px-3.5 py-2.5 border border-slate-200 rounded-lg text-base font-medium focus:ring-2 focus:ring-indigo-500 focus:outline-none" />

              <label class="block text-sm font-medium text-slate-700 mb-1.5 mt-5">Slug</label>
              
                <% if(errors && errors.slug){ %>
                <p class="text-red-500 text-xs mb-2"><%= errors.slug %></p>
                <% } %>
              <input type="text" name="slug"
              value="<%= oldData&& oldData.slug ? oldData.slug : "" %>"
              class="w-full px-3.5 py-2.5 border border-slate-200 rounded-lg text-sm text-slate-500 focus:ring-2 focus:ring-indigo-500 focus:outline-none" />

              <!-- <label class="block text-sm font-medium text-slate-700 mb-1.5 mt-5">Excerpt</label>
              <textarea rows="2" class="w-full px-3.5 py-2.5 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none resize-none">A practical guide to keeping Tailwind CSS maintainable as your design system and team grow.</textarea> -->
            </div>

            <div class="bg-white rounded-2xl border border-slate-200 p-6">
              <div class="flex items-center justify-between mb-3">
                <label class="block text-sm font-medium text-slate-700">Content</label>
                <% if(errors && errors.text){ %>
                <p class="text-red-500 text-xs mb-2"><%= errors.text %></p>
                <% } %>
                <div class="flex items-center gap-1 text-slate-400">
                  <button type="button" class="p-1.5 hover:bg-slate-100 rounded-md hover:text-slate-700" title="Bold"><i data-lucide="bold" class="w-4 h-4"></i></button>
                  <button type="button" class="p-1.5 hover:bg-slate-100 rounded-md hover:text-slate-700" title="Italic"><i data-lucide="italic" class="w-4 h-4"></i></button>
                  <button type="button" class="p-1.5 hover:bg-slate-100 rounded-md hover:text-slate-700" title="Link"><i data-lucide="link" class="w-4 h-4"></i></button>
                  <button type="button" class="p-1.5 hover:bg-slate-100 rounded-md hover:text-slate-700" title="List"><i data-lucide="list" class="w-4 h-4"></i></button>
                  <button type="button" class="p-1.5 hover:bg-slate-100 rounded-md hover:text-slate-700" title="Image"><i data-lucide="image" class="w-4 h-4"></i></button>
                  <button type="button" class="p-1.5 hover:bg-slate-100 rounded-md hover:text-slate-700" title="Quote"><i data-lucide="quote" class="w-4 h-4"></i></button>
                </div>
              </div>
              <textarea name="text" 
              rows="16" class="w-full px-3.5 py-3 border border-slate-200 rounded-lg text-sm leading-relaxed focus:ring-2 focus:ring-indigo-500 focus:outline-none resize-none"
              ><%= oldData&& oldData.text ? oldData.text : "" %></textarea>
            </div>
          </div>

          <!-- Sidebar settings -->
          <div class="space-y-6">
            <div class="bg-white rounded-2xl border border-slate-200 p-6">
              <h3 class="font-bold text-slate-900 mb-4 text-sm">Status</h3>
              <select name="status"
              class="w-full px-3.5 py-2.5 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                <option value="draft" selected>Draft</option>
                <option value="published">Published</option>
              </select>
            </div>

            <div class="bg-white rounded-2xl border border-slate-200 p-6">
              <h3 class="font-bold text-slate-900 mb-4 text-sm">Category</h3>
              <select name="category"
              class="w-full px-3.5 py-2.5 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                <% categories.forEach(category => { %>
                  <option value="<%= category.id %>"><%= category.title %></option>
                <% }) %>
              </select>
            </div>

            <div class="bg-white rounded-2xl border border-slate-200 p-6">
              <h3 class="font-bold text-slate-900 mb-4 text-sm">Tags</h3>
              <div class="flex flex-wrap gap-2 mb-3">
                <span class="inline-flex items-center gap-1.5 text-xs font-medium bg-slate-100 text-slate-600 px-2.5 py-1 rounded-full">
                  tailwindcss <button class="hover:text-red-600"><i data-lucide="x" class="w-3 h-3"></i></button>
                </span>
                <span class="inline-flex items-center gap-1.5 text-xs font-medium bg-slate-100 text-slate-600 px-2.5 py-1 rounded-full">
                  css <button class="hover:text-red-600"><i data-lucide="x" class="w-3 h-3"></i></button>
                </span>
                <span class="inline-flex items-center gap-1.5 text-xs font-medium bg-slate-100 text-slate-600 px-2.5 py-1 rounded-full">
                  design-systems <button class="hover:text-red-600"><i data-lucide="x" class="w-3 h-3"></i></button>
                </span>
              </div>
              <input type="text" placeholder="Add a tag and press enter" class="w-full px-3.5 py-2 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
            </div>

            <div class="bg-white rounded-2xl border border-slate-200 p-6">
              <h3 class="font-bold text-slate-900 mb-4 text-sm">Featured Image</h3>
              <div class="h-36 rounded-xl bg-gradient-to-br from-indigo-400 to-purple-500 flex items-center justify-center mb-3">
                <i data-lucide="image" class="w-8 h-8 text-white/70"></i>
              </div>
              <button class="w-full py-2 text-sm font-medium border border-slate-200 rounded-lg hover:bg-slate-50 flex items-center justify-center gap-2">
                <i data-lucide="upload" class="w-4 h-4"></i> Upload new image
              </button>
            </div>
            <div class="flex items-center gap-3">
          <button class="px-4 py-2 text-sm font-semibold text-slate-600 border border-slate-200 rounded-lg hover:bg-slate-50">Save Draft</button>
          <button class="px-4 py-2 bg-indigo-600 text-white text-sm font-semibold rounded-lg hover:bg-indigo-700 transition">Publish</button>
        </div>
          </div>
        </form>
      </main>
    </div>