<div class="flex-1 min-w-0">
      <header class="h-16 bg-white border-b border-slate-200 flex items-center justify-between px-4 sm:px-8 sticky top-0 z-20">
        <div class="flex items-center gap-3">
          <button @click="sidebarOpen=!sidebarOpen" class="lg:hidden p-2 text-slate-500"><i data-lucide="menu" class="w-5 h-5"></i></button>
          <h1 class="text-lg font-bold text-slate-900">Posts</h1>
        </div>
        <a href="/admin/new-post" class="inline-flex items-center gap-2 px-4 py-2 bg-indigo-600 text-white text-sm font-semibold rounded-lg hover:bg-indigo-700 transition">
          <i data-lucide="plus" class="w-4 h-4"></i> New Post
        </a>
      </header>

      <main class="p-4 sm:p-8">
        <% if(errors && errors.notAllowed) { %>
          <p class="text-red-500 text-xs mb-2"><%= errors.notAllowed %></p>
        <% } %>
        <% if(errors && errors.notFound) { %>
          <p class="text-red-500 text-xs mb-2"><%= errors.notFound %></p>
        <% } %>
        <!-- Filters -->
        <div class="bg-white rounded-2xl border border-slate-200 p-4 mb-6 flex flex-wrap items-center gap-3">
          <div class="relative flex-1 min-w-[200px]">
            <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
            <input type="text" placeholder="Search posts..." class="w-full pl-10 pr-4 py-2 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
          </div>
          <select class="px-3 py-2 border border-slate-200 rounded-lg text-sm text-slate-600 focus:ring-2 focus:ring-indigo-500 focus:outline-none">
            <option>All categories</option>
            <option>Frontend</option>
            <option>Backend</option>
            <option>DevOps</option>
          </select>
          <select class="px-3 py-2 border border-slate-200 rounded-lg text-sm text-slate-600 focus:ring-2 focus:ring-indigo-500 focus:outline-none">
            <option>All statuses</option>
            <option>Published</option>
            <option>Draft</option>
          </select>
        </div>

        <!-- Table -->
        <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden">
          <div class="overflow-x-auto thin-scrollbar">
            <table class="w-full text-sm">
              <thead class="bg-slate-50 text-slate-500 border-b border-slate-200">
                <tr>
                  <th class="text-left font-semibold px-5 py-3">Title</th>
                  <th class="text-left font-semibold px-5 py-3">Author</th>
                  <th class="text-left font-semibold px-5 py-3">Category</th>
                  <th class="text-left font-semibold px-5 py-3">Comments</th>
                  <th class="text-left font-semibold px-5 py-3">Status</th>
                  <th class="text-left font-semibold px-5 py-3">Date</th>
                  <th class="text-right font-semibold px-5 py-3">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <% posts.forEach(post => { %>
                  <tr class="hover:bg-slate-50">
                    <td class="px-5 py-3">
                      <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-lg bg-gradient-to-br from-indigo-400 to-purple-500 shrink-0"></div>
                        <!-- <div class="w-9 h-9 rounded-lg bg-gradient-to-br from-indigo-400 to-purple-500 shrink-0">
                          <img src="<%=post.image %>" alt="">
                        </div> -->
                        <span class="font-medium text-slate-800 line-clamp-1 max-w-xs"><%= post.title %></span>
                      </div>
                    </td>
                    <td class="px-5 py-3 text-slate-600"><%= post.author.username %></td>
                    <td class="px-5 py-3"><span class="text-xs font-medium bg-indigo-50 text-indigo-600 px-2.5 py-1 rounded-full">
                      <%= post.category.title %>
                    </span></td>
                    <td class="px-5 py-3 text-slate-600">12</td>
                    <td class="px-5 py-3"><span class="text-xs font-semibold text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-full">
                      <%= post.status %>
                    </span></td>
                    <td class="px-5 py-3 text-slate-500">Aug 18, 2026</td>
                    <td class="px-5 py-3 text-right">
                      <div class="flex justify-end gap-1">
                        <a href="/posts/<%= post.slug %>" title="View" class="p-2 text-slate-400 hover:text-indigo-600 rounded-lg hover:bg-slate-100"><i data-lucide="eye" class="w-4 h-4"></i></a>
                        <a href="/admin/posts/<%= post.slug %>" title="Edit" class="p-2 text-slate-400 hover:text-indigo-600 rounded-lg hover:bg-slate-100"><i data-lucide="pencil" class="w-4 h-4"></i></a>
                        <form action="/posts/<%= post.slug %>/delete" method="POST">
                        <button title="Delete" class="p-2 text-slate-400 hover:text-red-600 rounded-lg hover:bg-slate-100"><i data-lucide="trash-2" class="w-4 h-4"></i></button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }) %>
