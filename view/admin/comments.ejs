        <div class="flex items-center justify-between mt-4">
          <p class="text-sm text-slate-500">Showing <span class="font-medium text-slate-700">1-4</span> of <span class="font-medium text-slate-700">3,921</span> comments</p>
          <div class="flex gap-1">
            <button class="px-3 py-1.5 text-sm border border-slate-200 rounded-lg text-slate-400 cursor-not-allowed">Previous</button>
            <button class="px-3 py-1.5 text-sm border border-slate-200 rounded-lg bg-indigo-600 text-white">1</button>
            <button class="px-3 py-1.5 text-sm border border-slate-200 rounded-lg text-slate-600 hover:bg-slate-50">2</button>
            <button class="px-3 py-1.5 text-sm border border-slate-200 rounded-lg text-slate-600 hover:bg-slate-50">Next</button>
          </div>
        </div>
      </main>
    </div>