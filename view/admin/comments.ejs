<div class="flex-1 min-w-0">
      <header class="h-16 bg-white border-b border-slate-200 flex items-center justify-between px-4 sm:px-8 sticky top-0 z-20">
        <div class="flex items-center gap-3">
          <button @click="sidebarOpen=!sidebarOpen" class="lg:hidden p-2 text-slate-500"><i data-lucide="menu" class="w-5 h-5"></i></button>
          <h1 class="text-lg font-bold text-slate-900">Comments</h1>
        </div>
      </header>

      <main class="p-4 sm:p-8">
        <!-- Tabs -->
        <div class="flex gap-2 mb-6 border-b border-slate-200">
          <button @click="tab='all'" :class="tab==='all' ? 'border-indigo-600 text-indigo-600' : 'border-transparent text-slate-500 hover:text-slate-700'" class="px-4 py-2.5 text-sm font-semibold border-b-2 transition">All (3,921)</button>
          <button @click="tab='pending'" :class="tab==='pending' ? 'border-indigo-600 text-indigo-600' : 'border-transparent text-slate-500 hover:text-slate-700'" class="px-4 py-2.5 text-sm font-semibold border-b-2 transition">Pending (18)</button>
          <button @click="tab='approved'" :class="tab==='approved' ? 'border-indigo-600 text-indigo-600' : 'border-transparent text-slate-500 hover:text-slate-700'" class="px-4 py-2.5 text-sm font-semibold border-b-2 transition">Approved</button>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200 divide-y divide-slate-100">
<% comments.forEach(comment => { %>
          <div class="p-5 flex flex-col sm:flex-row sm:items-start gap-4">
            <img src="<%= comment.user.avatar %>" class="w-9 h-9 rounded-full shrink-0" alt="Commenter" />
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-1">
                <span class="font-semibold text-slate-800 text-sm"><%= comment.user.username %></span>
                <span class="text-xs text-slate-400">· 2 hours ago</span>
                <span class="text-xs font-semibold
                <%= comment.status === "approved" ? 
                "text-emerald-600 bg-emerald-50 " : comment.status === "rejected" ? "text-red-600 bg-red-50 " 
                : "text-amber-600 bg-amber-50 " %>
                 px-2 py-0.5 rounded-full"><%= comment.status %></span>
              </div>
              <p class="text-sm text-slate-600 mb-2"><%= comment.text %></p>
              <p class="text-xs text-slate-400">On <a href="/posts/<%= comment.post.slug %>" class="text-indigo-600 hover:underline"><%= comment.post.title %></a></p>
            </div>
            <div class="flex gap-2 shrink-0">
<% if(comment.status === "approved" || comment.status === "rejected") { %>
            <form action="/comments/<%= comment.id %>/delete" method="POST">
            <button title="Delete" class="p-2 text-slate-400 hover:text-red-600 rounded-lg hover:bg-slate-100"><i data-lucide="trash-2" class="w-4 h-4"></i></button>
            </form>
<% } else { %>
              <form action="/comments/<%= comment.id %>/approve" method="POST">
              <button class="px-3 py-1.5 text-xs font-semibold text-emerald-600 border border-emerald-200 rounded-lg hover:bg-emerald-50 flex items-center gap-1"><i data-lucide="check" class="w-3.5 h-3.5"></i> Approve</button>
              </form>
              <form action="/comments/<%= comment.id %>/reject" method="POST">
              <button class="px-3 py-1.5 text-xs font-semibold text-red-600 border border-red-200 rounded-lg hover:bg-red-50 flex items-center gap-1"><i data-lucide="x" class="w-3.5 h-3.5"></i> Reject</button>
            </form>
<% } %>
            </div>
          </div>
<% }) %>

