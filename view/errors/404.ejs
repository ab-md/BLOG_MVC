      <i data-lucide="file-question" class="w-10 h-10 text-indigo-600"></i>
    </div>

    <p class="text-sm font-bold uppercase tracking-widest text-indigo-600 mb-3">
      Error 404
    </p>

    <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight mb-4">
