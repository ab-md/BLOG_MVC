      <button
        type="button"
        onclick="history.back()"
        class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-lg border border-slate-200 bg-white text-slate-700 font-semibold hover:bg-slate-50 transition"
      >
        <i data-lucide="arrow-left" class="w-4 h-4"></i>
