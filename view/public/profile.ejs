<main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Cover / header -->
    <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden mb-8">
      <div class="h-32 bg-gradient-to-br from-indigo-500 via-indigo-600 to-purple-700"></div>
      <div class="px-6 pb-6">
        <div class="flex items-end -mt-10 gap-4">
          <img src="<%= user.avatar %>" class="w-24 h-24 rounded-full border-4 border-white shadow-sm" alt="Profile avatar" />
          <div class="pb-1">
            <h1 class="text-xl font-bold text-slate-900"><%= user.username %></h1>
            <p class="text-sm text-slate-500">@<%= user.username %> · Joined Jan 2025</p>
          </div>
        </div>
        <div class="flex gap-6 mt-4 text-sm text-slate-500">
          <span><span class="font-bold text-slate-800">32</span> Posts</span>
          <span><span class="font-bold text-slate-800">128</span> Comments</span>
          <span><span class="font-bold text-slate-800">4</span> Categories followed</span>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[220px_1fr] gap-8">
      <!-- Side tabs -->
      <nav class="space-y-1">
        <button @click="tab='profile'" :class="tab==='profile' ? 'bg-indigo-50 text-indigo-600' : 'text-slate-600 hover:bg-slate-50'" class="w-full flex items-center gap-2 px-3 py-2.5 rounded-lg text-sm font-medium transition">
          <i data-lucide="user" class="w-4 h-4"></i> Profile Info
        </button>
        <button @click="tab='security'" :class="tab==='security' ? 'bg-indigo-50 text-indigo-600' : 'text-slate-600 hover:bg-slate-50'" class="w-full flex items-center gap-2 px-3 py-2.5 rounded-lg text-sm font-medium transition">
          <i data-lucide="shield" class="w-4 h-4"></i> Security
        </button>
        <button @click="tab='posts'" :class="tab==='posts' ? 'bg-indigo-50 text-indigo-600' : 'text-slate-600 hover:bg-slate-50'" class="w-full flex items-center gap-2 px-3 py-2.5 rounded-lg text-sm font-medium transition">
          <i data-lucide="file-text" class="w-4 h-4"></i> My Posts
        </button>
        <button @click="tab='comments'" :class="tab==='comments' ? 'bg-indigo-50 text-indigo-600' : 'text-slate-600 hover:bg-slate-50'" class="w-full flex items-center gap-2 px-3 py-2.5 rounded-lg text-sm font-medium transition">
          <i data-lucide="message-circle" class="w-4 h-4"></i> My Comments
        </button>
      </nav>

      <!-- Content -->
      <div>
        <!-- Profile info tab -->
        <div x-show="tab==='profile'" class="bg-white rounded-2xl border border-slate-200 p-6">
<% if (errors && errors.username) { %>
<p class="text-red-500 text-sm mb-8"><%= errors.username %></p>
<% } %>
<% if (errors && errors.password) { %>
<p class="text-red-500 text-sm mb-8"><%= errors.password %></p>
<% } %>
<% if (errors && errors.confirmPassword) { %>
<p class="text-red-500 text-sm mb-8"><%= errors.confirmPassword %></p>
<% } %>
<% if (errors && errors.currentPassword) { %>
<p class="text-red-500 text-sm mb-8"><%= errors.currentPassword %></p>
<% } %>
<% if (errors && errors.incorrectPassword) { %>
<p class="text-red-500 text-sm mb-8"><%= errors.incorrectPassword %></p>
<% } %>
          <h2 class="font-bold text-slate-900 mb-6">Profile Information</h2>
          <div class="flex items-center gap-4 mb-6">
            <img src="<%= user.avatar %>" class="w-16 h-16 rounded-full" alt="Profile avatar" />
            <div class="flex gap-2">
              <button class="px-3 py-1.5 text-sm font-medium border border-slate-200 rounded-lg hover:bg-slate-50">Change photo</button>
              <button class="px-3 py-1.5 text-sm font-medium text-red-600 hover:bg-red-50 rounded-lg">Remove</button>
            </div>
          </div>
          <form class="space-y-5" action="/auth/<%= user.id %>/username" method="POST">
            <!-- <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-slate-700 mb-1.5">First name</label>
                <input type="text" value="Leila" class="w-full px-3.5 py-2.5 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
              </div>
              <div>
                <label class="block text-sm font-medium text-slate-700 mb-1.5">Last name</label>
                <input type="text" value="Tabrizi" class="w-full px-3.5 py-2.5 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
              </div>
            </div> -->
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1.5">Username</label>
              <input
              type="text" value="<%= user.username %>"  name="username"
              class="w-full px-3.5 py-2.5 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1.5">Email address</label>
              <input
              type="email" value="<%= user.email %>"
              disabled
              class="w-full px-3.5 py-2.5 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1.5">Bio</label>
              <textarea rows="3" class="w-full px-3.5 py-2.5 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none resize-none">Product-minded frontend developer. Writing about UX, accessibility, and design systems.</textarea>
            </div>
            <div class="flex justify-end gap-3 pt-2">
              <button type="button" class="px-4 py-2.5 text-sm font-semibold text-slate-600 hover:bg-slate-50 rounded-lg">Cancel</button>
              <button type="submit" class="px-5 py-2.5 text-sm font-semibold text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 transition">Save Changes</button>
            </div>
          </form>
        </div>

        <!-- Security tab -->
        <div x-show="tab==='security'" x-cloak class="bg-white rounded-2xl border border-slate-200 p-6">
          <h2 class="font-bold text-slate-900 mb-6">Change Password</h2>
          <form class="space-y-5 max-w-md" action="/auth/<%= user.id %>/password" method="POST">
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1.5">Current password</label>
              <input type="password" name="currentPassword"
              placeholder="••••••••" class="w-full px-3.5 py-2.5 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1.5">New password</label>
              <input type="password" name="password"
              placeholder="••••••••" class="w-full px-3.5 py-2.5 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1.5">Confirm new password</label>
              <input type="password" name="confirmPassword"
              placeholder="••••••••" class="w-full px-3.5 py-2.5 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
            </div>
            <div class="flex justify-end pt-2">
              <button type="submit" class="px-5 py-2.5 text-sm font-semibold text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 transition">Update Password</button>
            </div>
          </form>

          <div class="mt-10 pt-6 border-t border-slate-100">
            <h3 class="font-bold text-red-600 mb-2">Danger Zone</h3>
            <p class="text-sm text-slate-500 mb-4">Once you delete your account, there is no going back. Please be certain.</p>
            <button class="px-4 py-2 text-sm font-semibold text-red-600 border border-red-200 rounded-lg hover:bg-red-50">Delete my account</button>
          </div>
        </div>

        <!-- My posts tab -->
        <div x-show="tab==='posts'" x-cloak class="space-y-4">
          <div class="flex justify-between items-center mb-2">
            <h2 class="font-bold text-slate-900">My Posts</h2>
            <a href="/" class="text-sm font-semibold text-indigo-600 hover:text-indigo-700 flex items-center gap-1"><i data-lucide="plus" class="w-4 h-4"></i> New Post</a>
          </div>
          <div class="bg-white rounded-2xl border border-slate-200 p-4 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 rounded-lg bg-gradient-to-br from-indigo-400 to-purple-500 shrink-0"></div>
              <div>
                <a href="/post-detail" class="font-semibold text-slate-800 hover:text-indigo-600 line-clamp-1">Mastering Tailwind CSS: Building Scalable Design Systems</a>
                <p class="text-xs text-slate-400">Published · Aug 18, 2026 · 12 comments</p>
              </div>
            </div>
            <span class="text-xs font-semibold text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-full">Published</span>
          </div>
          <div class="bg-white rounded-2xl border border-slate-200 p-4 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 rounded-lg bg-gradient-to-br from-amber-400 to-orange-500 shrink-0"></div>
              <div>
                <a href="/post-detail" class="font-semibold text-slate-800 hover:text-indigo-600 line-clamp-1">Draft: Notes on Component Testing Strategies</a>
                <p class="text-xs text-slate-400">Last edited 2 days ago</p>
              </div>
            </div>
            <span class="text-xs font-semibold text-slate-500 bg-slate-100 px-2.5 py-1 rounded-full">Draft</span>
          </div>
        </div>

        <!-- My comments tab -->
        <div x-show="tab==='comments'" x-cloak class="space-y-4">
          <h2 class="font-bold text-slate-900 mb-2">My Comments</h2>
          <div class="bg-white rounded-2xl border border-slate-200 p-4">
            <p class="text-sm text-slate-600 mb-2">"Curious how you handle dark mode tokens alongside this setup — would love a follow-up post!"</p>
            <p class="text-xs text-slate-400">On <a href="/post-detail" class="text-indigo-600 hover:underline">Mastering Tailwind CSS</a> · 4 days ago</p>
          </div>
          <div class="bg-white rounded-2xl border border-slate-200 p-4">
            <p class="text-sm text-slate-600 mb-2">"This lines up with what we've seen in production — great write-up."</p>
            <p class="text-xs text-slate-400">On <a href="/post-detail" class="text-indigo-600 hover:underline">Designing REST APIs That Scale</a> · 1 week ago</p>
          </div>
        </div>
      </div>
    </div>
  </main>