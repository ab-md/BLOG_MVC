<div class="min-h-screen grid lg:grid-cols-2">

    <!-- Left / brand panel -->
    <div class="hidden lg:flex flex-col justify-between bg-gradient-to-br from-indigo-600 via-indigo-600 to-purple-700 p-12 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, white 1px, transparent 1px); background-size: 24px 24px;"></div>
      <a href="/" class="flex items-center gap-2 relative">
        <div class="h-10 w-10 rounded-xl bg-white/15 flex items-center justify-center">
          <i data-lucide="feather" class="w-5 h-5 text-white"></i>
        </div>
        <span class="text-xl font-bold text-white">DevBlog</span>
      </a>
      <div class="relative">
        <h2 class="text-3xl font-extrabold text-white leading-tight mb-4">Join a community of curious developers.</h2>
        <p class="text-indigo-100">Create an account to comment, save posts, and personalize your feed.</p>
      </div>
      <p class="text-indigo-200 text-sm relative">© 2026 DevBlog. All rights reserved.</p>
    </div>

    <!-- Right / form panel -->
    <div class="flex items-center justify-center p-6 sm:p-12">
      <div class="w-full max-w-sm">
        <div class="lg:hidden flex items-center gap-2 mb-10 justify-center">
          <div class="h-9 w-9 rounded-xl bg-indigo-600 flex items-center justify-center">
            <i data-lucide="feather" class="w-5 h-5 text-white"></i>
          </div>
          <span class="text-lg font-bold text-slate-900">DevBlog</span>
        </div>

        <h1 class="text-2xl font-extrabold text-slate-900 mb-1">Create your account</h1>
        <p class="text-slate-500 text-sm mb-8">Start reading and sharing in less than a minute.</p>
            <% if(errors && errors.existing) { %>
              <span class="text-xs text-red-500 mb-4 inline-block mb-6"><%= errors.existing %></span>
              <% } %>

        <form class="space-y-5" action="/auth/register" method="POST">
          <!-- <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="firstName" class="block text-sm font-medium text-slate-700 mb-1.5">Username</label>
              <input id="firstName" type="text" placeholder="Sara" class="w-full px-3.5 py-2.5 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none focus:border-indigo-500" />
            </div>
            <div>
              <label for="lastName" class="block text-sm font-medium text-slate-700 mb-1.5">Last name</label>
              <input id="lastName" type="text" placeholder="Ahmadi" class="w-full px-3.5 py-2.5 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none focus:border-indigo-500" />
            </div>
          </div> -->

          <div>
            <label for="username" class="block text-sm font-medium text-slate-700 mb-1.5">Username</label>
            <div class="relative">
              <i data-lucide="at-sign" class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
              <input 
              value="<%= oldData && oldData.username ? oldData.username : ''%>"
              id="username" name="username" type="text" 
              placeholder="sara_ahmadi" 
              class="w-full pl-10 pr-4 py-2.5 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none focus:border-indigo-500" 
              />
            </div>
            <% if(errors && errors.username) { %>
              <span class="text-xs text-red-500"><%= errors.username %></span>
              <% } %>
          </div>

          <div>
            <label for="email" class="block text-sm font-medium text-slate-700 mb-1.5">Email address</label>
            <div class="relative">
              <i data-lucide="mail" class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
              <input 
              value="<%= oldData && oldData.email ? oldData.email : ''%>"
              id="email" name="email" type="email" placeholder="you@example.com" 
              class="w-full pl-10 pr-4 py-2.5 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none focus:border-indigo-500" 
              />
            </div>
              <% if(errors && errors.email) { %>
                <span class="text-xs text-red-500"><%= errors.email %></span>
                <% } %>
          </div>

          <div>
            <label for="password" class="block text-sm font-medium text-slate-700 mb-1.5">Password</label>
            <div class="relative" x-data="{ show:false }">
              <i data-lucide="lock" class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
              <input :type="show ? 'text' : 'password'" id="password" name="password" placeholder="Minimum 6 characters" class="w-full pl-10 pr-10 py-2.5 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none focus:border-indigo-500" />
              <button type="button" @click="show = !show" class="absolute right-3.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600">
                <i data-lucide="eye" class="w-4 h-4" x-show="!show"></i>
                <i data-lucide="eye-off" class="w-4 h-4" x-show="show" x-cloak></i>
              </button>
            </div>
              <% if(errors && errors.password) { %>
                <span class="text-xs text-red-500"><%= errors.password %></span>
                <% } %>
          </div>

          <div>
            <label for="confirmPassword" class="block text-sm font-medium text-slate-700 mb-1.5">Confirm Password</label>
            <div class="relative" x-data="{ show:false }">
              <i data-lucide="lock" class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
              <input :type="show ? 'text' : 'password'" id="confirmPassword" name="confirmPassword" placeholder="Minimum 6 characters" class="w-full pl-10 pr-10 py-2.5 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none focus:border-indigo-500" />
              <button type="button" @click="show = !show" class="absolute right-3.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600">
                <i data-lucide="eye" class="w-4 h-4" x-show="!show"></i>
                <i data-lucide="eye-off" class="w-4 h-4" x-show="show" x-cloak></i>
              </button>
            </div>
              <% if(errors && errors.confirmPassword) { %>
                <span class="text-xs text-red-500"><%= errors.confirmPassword %></span>
                <% } %>
          </div>

          <label class="flex items-start gap-2 text-sm text-slate-600">
            <input type="checkbox" class="mt-0.5 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" />
            <span>I agree to the <a href="#" class="text-indigo-600 hover:text-indigo-700 font-medium">Terms of Service</a> and <a href="#" class="text-indigo-600 hover:text-indigo-700 font-medium">Privacy Policy</a></span>
          </label>

          <button type="submit" class="w-full py-2.5 bg-indigo-600 text-white font-semibold rounded-lg hover:bg-indigo-700 transition shadow-sm">Create Account</button>
        </form>

        <div class="flex items-center gap-3 my-6">
          <div class="h-px flex-1 bg-slate-200"></div>
          <span class="text-xs text-slate-400 font-medium">OR</span>
          <div class="h-px flex-1 bg-slate-200"></div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <button class="flex items-center justify-center gap-2 py-2.5 border border-slate-200 rounded-lg text-sm font-medium text-slate-700 hover:bg-slate-50 transition">
            <i data-lucide="github" class="w-4 h-4"></i> GitHub
          </button>
          <button class="flex items-center justify-center gap-2 py-2.5 border border-slate-200 rounded-lg text-sm font-medium text-slate-700 hover:bg-slate-50 transition">
            <i data-lucide="chrome" class="w-4 h-4"></i> Google
          </button>
        </div>

        <p class="text-center text-sm text-slate-500 mt-8">
          Already have an account? <a href="/login" class="font-semibold text-indigo-600 hover:text-indigo-700">Log in</a>
        </p>
        <p class="text-center text-sm mt-3">
          <a href="/" class="text-slate-400 hover:text-slate-600 inline-flex items-center gap-1"><i data-lucide="arrow-left" class="w-3.5 h-3.5"></i> Back to home</a>
        </p>
      </div>
    </div>
  </div>