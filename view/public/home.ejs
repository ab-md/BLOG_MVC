<!-- Hero -->
<section
  class="relative overflow-hidden bg-gradient-to-br from-indigo-600 via-indigo-600 to-purple-700"
>
  <div
    class="absolute inset-0 opacity-10"
    style="
      background-image: radial-gradient(
        circle at 20% 20%,
        white 1px,
        transparent 1px
      );
      background-size: 24px 24px;
    "
  ></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 relative">
    <div class="max-w-2xl">
      <span
        class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/15 text-white text-xs font-semibold mb-5"
      >
        <i data-lucide="sparkles" class="w-3.5 h-3.5"></i> Welcome to DevBlog
      </span>
      <h1
        class="text-4xl sm:text-5xl font-extrabold text-white leading-tight mb-4"
      >
        Stories, ideas & tutorials for curious developers.
      </h1>
      <p class="text-indigo-100 text-lg mb-8">
        Explore articles across web development, design, and software
        engineering — written by the community, for the community.
      </p>
      <form class="flex flex-col sm:flex-row gap-3 max-w-md">
        <input
          type="text"
          placeholder="Search articles..."
          class="flex-1 px-4 py-3 rounded-lg border-0 focus:ring-2 focus:ring-white/50 text-slate-800 placeholder:text-slate-400"
        />
        <button
          type="submit"
          class="px-6 py-3 bg-white text-indigo-700 font-semibold rounded-lg hover:bg-indigo-50 transition shadow-sm"
        >
          Search
        </button>
      </form>
    </div>
  </div>
</section>

