 <!-- Sidebar -->
    <aside :class="sidebarOpen ? 'translate-x-0' : '-translate-x-full'" class="fixed lg:translate-x-0 lg:static z-40 w-64 h-screen bg-slate-900 text-slate-300 flex flex-col transition-transform duration-200">
      <div class="h-16 flex items-center gap-2 px-6 border-b border-slate-800 shrink-0">
        <div class="h-8 w-8 rounded-lg bg-indigo-600 flex items-center justify-center">
          <i data-lucide="feather" class="w-4 h-4 text-white"></i>
        </div>
        <span class="text-white font-bold">DevBlog Admin</span>
      </div>

      <nav class="flex-1 overflow-y-auto thin-scrollbar px-3 py-4 space-y-1">
        <a href="/admin" class="flex items-center gap-3 px-3 py-2.5 rounded-lg bg-slate-800 text-white text-sm font-medium">
          <i data-lucide="layout-dashboard" class="w-4 h-4"></i> Dashboard
        </a>
        <p class="text-xs font-semibold text-slate-500 px-3 pt-4 pb-1 uppercase tracking-wider">Content</p>
        <a href="/admin/posts" class="flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-slate-800 hover:text-white text-sm font-medium transition">
          <i data-lucide="file-text" class="w-4 h-4"></i> Posts
        </a>
        <a href="/admin/categories" class="flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-slate-800 hover:text-white text-sm font-medium transition">
          <i data-lucide="folder" class="w-4 h-4"></i> Categories
        </a>
        <a href="/admin/comments" class="flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-slate-800 hover:text-white text-sm font-medium transition">
          <i data-lucide="message-circle" class="w-4 h-4"></i> Comments
        </a>
        <p class="text-xs font-semibold text-slate-500 px-3 pt-4 pb-1 uppercase tracking-wider">People</p>
        <a href="/admin/users" class="flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-slate-800 hover:text-white text-sm font-medium transition">
          <i data-lucide="users" class="w-4 h-4"></i> Users
        </a>
      </nav>

      <div class="p-4 border-t border-slate-800 shrink-0">
        <a href="/" class="flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-slate-800 hover:text-white text-sm font-medium transition">
          <i data-lucide="arrow-left" class="w-4 h-4"></i> Back to site
        </a>
        <form action="/auth/logout" method="POST">
        <button 
        class="flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-red-900/40 hover:text-red-300 text-sm font-medium transition">
          <i data-lucide="log-out" class="w-4 h-4"></i> Log out
        </button>
        </form>
      </div>
    </aside>

    <!-- Overlay for mobile -->
    <div x-show="sidebarOpen" x-cloak @click="sidebarOpen=false" class="fixed inset-0 bg-black/40 z-30 lg:hidden"></div>
