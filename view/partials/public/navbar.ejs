
    <!-- Navbar -->
    <header
      x-data="{ open:false }"
      class="sticky top-0 z-50 bg-white/90 backdrop-blur border-b border-slate-200"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <a href="/" class="flex items-center gap-2">
            <div
              class="h-9 w-9 rounded-xl bg-indigo-600 flex items-center justify-center"
            >
              <i data-lucide="feather" class="w-5 h-5 text-white"></i>
            </div>
            <span class="text-lg font-bold text-slate-900">DevBlog</span>
          </a>

          <nav class="hidden md:flex items-center gap-8 text-sm font-medium">
            <a href="/" class="text-indigo-600">Home</a>
            <a
              href="/categories"
              class="text-slate-600 hover:text-indigo-600 transition"
              >Categories</a
            >
            <a
              href="/post-detail"
              class="text-slate-600 hover:text-indigo-600 transition"
              >Sample Post</a
            >
          </nav>

          <div class="hidden md:flex items-center gap-3">
            <% if(!user || user === undefined) { %>
            <a
              href="/login"
              class="px-4 py-2 text-sm font-semibold text-slate-700 hover:text-indigo-600 transition"
              >Log in</a
            >
            <a
              href="/register"
              class="px-4 py-2 text-sm font-semibold text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 transition shadow-sm"
              >Sign up</a
            >
            <% } else { %>
              <form action="/auth/logout" method="POST">
              <button
                class="px-4 py-2 text-sm font-semibold text-slate-700 hover:text-indigo-600 transition"
                >Log out</button
              >
              </form>
              <div class="w-px h-6 bg-slate-200"></div>
              <a
                href="/profile"
                title="Profile"
                class="w-9 h-9 rounded-full bg-slate-100 flex items-center justify-center hover:bg-slate-200 transition"
              >
                <i data-lucide="user" class="w-4 h-4 text-slate-600"></i>
              </a>
              <a
                href="/admin"
                title="Admin Panel"
                class="w-9 h-9 rounded-full bg-slate-100 flex items-center justify-center hover:bg-slate-200 transition"
              >
                <i
                  data-lucide="layout-dashboard"
                  class="w-4 h-4 text-slate-600"
                ></i>
              </a>
            <% }%>
          </div>

          <button @click="open = !open" class="md:hidden p-2 text-slate-600">
            <i data-lucide="menu" class="w-6 h-6"></i>
          </button>
        </div>

        <div x-show="open" x-cloak class="md:hidden pb-4 space-y-2">
          <a
            href="/"
            class="block px-3 py-2 rounded-lg bg-indigo-50 text-indigo-600 font-medium"
            >Home</a
          >
          <a
            href="/categories"
            class="block px-3 py-2 rounded-lg text-slate-600 hover:bg-slate-50"
            >Categories</a
          >
          <a
            href="/post-detail"
            class="block px-3 py-2 rounded-lg text-slate-600 hover:bg-slate-50"
            >Sample Post</a
          >
          <a
            href="/profile"
            class="block px-3 py-2 rounded-lg text-slate-600 hover:bg-slate-50"
            >Profile</a
          >
          <a
            href="/admin"
            class="block px-3 py-2 rounded-lg text-slate-600 hover:bg-slate-50"
            >Admin Panel</a
          >
          <div class="flex gap-2 pt-2">
            <a
              href="/login"
              class="flex-1 text-center px-4 py-2 text-sm font-semibold border border-slate-200 rounded-lg"
              >Log in</a
            >
            <a
              href="/register"
              class="flex-1 text-center px-4 py-2 text-sm font-semibold text-white bg-indigo-600 rounded-lg"
              >Sign up</a
            >
          </div>
        </div>
      </div>
    </header>
